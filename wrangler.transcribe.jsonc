{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "transcribechats-unified",
  "main": "cloudflare/transcribe-worker.mjs",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "vars": { "ENABLE_LOCAL_ORIGIN": "true" },
  "ai": {
    "binding": "AI"
  },
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1701",
      "simple": {
        "limit": 3,
        "period": 60
      }
    },
    {
      "name": "GEMINI_RATE_LIMITER",
      "namespace_id": "1702",
      "simple": {
        "limit": 1,
        "period": 60
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "GEMINI_JOBS",
        "class_name": "GeminiSummaryJob"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-gemini-summary-jobs",
      "new_sqlite_classes": [
        "GeminiSummaryJob"
      ]
    }
  ]
}
