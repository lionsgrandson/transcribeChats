# Public build configuration only. Never put a service-role or AI secret in VITE_*.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Cloudflare Worker endpoint, e.g. https://transcribechats-whisper.your-account.workers.dev
VITE_CLOUD_TRANSCRIBE_URL=

# Optional local Docker/Python Whisper fallback if cloud URL is blank.
VITE_WORKER_URL=http://localhost:8787

# Local-only optional speaker diarization for the Python worker.
ENABLE_DIARIZATION=true
INSTALL_DIARIZATION=true
PYANNOTE_TOKEN=
PYANNOTE_MODEL=pyannote/speaker-diarization-community-1
PYANNOTE_DEVICE=cuda
