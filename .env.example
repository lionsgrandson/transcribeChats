VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_WORKER_URL=http://localhost:8787
VITE_CODECRAFTER_CRM_URL=https://codecraftercrm.netlify.app

# Best speaker separation: run `START-LEARNING.cmd setup` once on Windows.
# It securely saves a Hugging Face READ token here after you accept access to:
# https://huggingface.co/pyannote/speaker-diarization-community-1
# Without a token, transcription still works with local acoustic speaker separation.
ENABLE_DIARIZATION=true
INSTALL_DIARIZATION=true
PYANNOTE_TOKEN=
PYANNOTE_MODEL=pyannote/speaker-diarization-community-1
PYANNOTE_DEVICE=cuda
