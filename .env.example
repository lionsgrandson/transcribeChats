VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_WORKER_URL=http://localhost:8787
VITE_CODECRAFTER_CRM_URL=https://codecraftercrm.netlify.app

# Optional but recommended for best speaker separation.
# Accept the pyannote/speaker-diarization-community-1 model terms on Hugging Face,
# then put a read token here. Without it, the app uses its built-in acoustic fallback.
ENABLE_DIARIZATION=true
INSTALL_DIARIZATION=true
PYANNOTE_TOKEN=
PYANNOTE_MODEL=pyannote/speaker-diarization-community-1
PYANNOTE_DEVICE=cuda
