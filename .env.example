# Public build configuration only. Never put a service-role or AI secret in VITE_*.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Hosted speech-to-text backend. Leave blank to transcribe with local CUDA.
VITE_CLOUD_TRANSCRIBE_URL=
# Optional hosted Gemini backend for a desktop build (uses Supabase sign-in).
VITE_AI_API_URL=
# Set hosted in Cloudflare build settings; leave blank for desktop development.
VITE_RUNTIME_MODE=
# Public Turnstile site key when the Supabase project's CAPTCHA protection is enabled.
VITE_TURNSTILE_SITE_KEY=

# Optional local Docker/Python Whisper fallback if cloud URL is blank.
VITE_WORKER_URL=http://localhost:8787

# Local-only optional speaker diarization for the Python worker.
ENABLE_DIARIZATION=true
INSTALL_DIARIZATION=true
PYANNOTE_TOKEN=
PYANNOTE_MODEL=pyannote/speaker-diarization-community-1
PYANNOTE_DEVICE=cuda
